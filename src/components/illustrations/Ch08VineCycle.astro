---
// The vine's annual growth cycle as a timeline, with months for both hemispheres
// and the main hazards marked above the stage where they strike.
interface Stage { name: string; en: string; north: string; south: string }
interface Hazard { at: number; text: string }
interface Props { stages: Stage[]; hazards?: Hazard[]; labels: { north: string; south: string } }
const { stages, hazards = [], labels } = Astro.props;
const x0 = 108;
const step = stages.length > 1 ? (590 - x0) / (stages.length - 1) : 0;
const xs = stages.map((_, i) => x0 + i * step);
const hx = (at: number) => x0 + at * step;
---
<svg viewBox="0 0 640 230" role="img" aria-label={stages.map((s) => s.name).join(' → ')} class="illo">
  <defs>
    <marker id="ch08-cycle-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
      <path d="M0 0 L10 5 L0 10" fill="none" stroke="currentColor" stroke-width="1.5" />
    </marker>
  </defs>
  <g fill="none" stroke="currentColor" stroke-width="1.25">
    <path d="M60 86 H628" marker-end="url(#ch08-cycle-arr)" />
    {hazards.map((h) => <path d={`M${hx(h.at)} 44 V74`} stroke-dasharray="2 3" />)}
    {xs.map((x, i) => (i === xs.length - 1 ? null : <circle cx={x} cy="86" r="7" style="fill: var(--bg)" />))}
    <path d="M8 156 H632" stroke-dasharray="1 4" />
  </g>
  <g fill="currentColor"><circle cx={xs[xs.length - 1]} cy="86" r="7" /></g>
  <g class="illo-text">
    {hazards.map((h) => <text x={hx(h.at)} y="36" text-anchor="middle" class="warn">{h.text}</text>)}
    {stages.map((s, i) => (
      <>
        <text x={xs[i]} y="118" text-anchor="middle">{s.name}</text>
        <text x={xs[i]} y="136" text-anchor="middle" class="small">{s.en}</text>
        <text x={xs[i]} y="184" text-anchor="middle" class="month">{s.north}</text>
        <text x={xs[i]} y="214" text-anchor="middle" class="month">{s.south}</text>
      </>
    ))}
    <text x="8" y="184" class="row">{labels.north}</text>
    <text x="8" y="214" class="row">{labels.south}</text>
  </g>
</svg>

<style>
  .illo { width: 100%; max-width: 640px; color: var(--fg); }
  .illo-text { font: 500 15px var(--sans); fill: currentColor; }
  .illo-text .small { font-size: 12px; fill: var(--muted); }
  .illo-text .month { font-size: 13px; }
  .illo-text .row { font-size: 13px; font-weight: 600; }
  .illo-text .warn { font-size: 12px; fill: var(--muted); }
</style>
