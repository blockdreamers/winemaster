---
// Sugar rises and acidity falls between véraison and harvest; the picking window
// chosen along that curve decides the style of wine.
interface Props { labels: { sugar: string; acid: string; start: string; time: string; windows: [string, string, string] } }
const { labels } = Astro.props;
const bands = [ [178, 250], [330, 430], [512, 596] ];
---
<svg viewBox="0 0 640 260" role="img" aria-label={`${labels.sugar} ↑, ${labels.acid} ↓ · ${labels.windows.join(', ')}`} class="illo">
  <defs>
    <marker id="ch08-ripe-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
      <path d="M0 0 L10 5 L0 10" fill="none" stroke="currentColor" stroke-width="1.5" />
    </marker>
  </defs>
  <g fill="none" stroke="currentColor" stroke-width="1.25">
    {bands.map(([a, b]) => <rect x={a} y="36" width={b - a} height="174" stroke-dasharray="2 4" />)}
    <path d="M60 30 V210 H612" marker-end="url(#ch08-ripe-arr)" />
    <path d="M60 192 C 240 182, 400 76, 600 48" stroke-width="2.25" />
    <path d="M60 52 C 240 64, 400 166, 600 190" stroke-width="2.25" stroke-dasharray="7 5" />
  </g>
  <g class="illo-text">
    {bands.map(([a, b], i) => <text x={(a + b) / 2} y="26" text-anchor="middle" class="small">{labels.windows[i]}</text>)}
    <text x="604" y="46" class="label">{labels.sugar}</text>
    <text x="604" y="196" class="label">{labels.acid}</text>
    <text x="60" y="234" text-anchor="middle" class="small">{labels.start}</text>
    <text x="612" y="234" text-anchor="end" class="small">{labels.time}</text>
  </g>
</svg>

<style>
  .illo { width: 100%; max-width: 640px; color: var(--fg); }
  .illo-text { font: 500 15px var(--sans); fill: currentColor; }
  .illo-text .small { font-size: 13px; fill: var(--muted); }
  .illo-text .label { font-weight: 600; }
</style>
