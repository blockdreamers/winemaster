---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base lang="ko" title="404">
  <div class="wrap" style="padding:128px 16px">
    <p class="eyebrow">404</p>
    <h1>페이지를 찾을 수 없어요</h1>
    <p class="lead" style="margin-top:16px">Page not found.</p>
    <p style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap">
      <a class="btn" href={u('/ko/')}>WineMaster 한국어</a>
      <a class="btn" href={u('/en/')}>WineMaster English</a>
    </p>
  </div>
</Base>
